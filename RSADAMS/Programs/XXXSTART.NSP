/* TODO Enter your code here
DEFINE DATA LOCAL
*
1 SA-DAMS-DATA VIEW OF SA-DAMS
  2 DAM-NAME (A50)
  2 IMPOUNDS (A50)
  2 NEAREST-LOCAL (A50)
  2 PROVINCE (A50)
  2 ALTENATIVE-NAME (A50)
  2 DAM-ID (N3.0)
  2 YEAR (N4.0)
  2 RESERVOUR-VOLUME (N10.4)
  2 SURFACE-AREA (N10.4)
  2 WALL-HEIGHT (N10.4)
  2 DAM-RECORD (A200)

****************************************************************** 
1 #DAM1-RECORD (A200)
1 #DAM-RECORD (A200)
1 #DAM-NAME (A50)
1 #IMPOUNDS (A50)
1 #NEAREST-LOCAL (A50)
1 #PROVINCE (A50)
1 #DAM-ID (A3)
1 #YEAR (A4)
1 #RESERVOUR-VOLUME (A12)
1 #SURFACE-AREA (A12)
1 #WALL-HEIGHT (A12)
1 #ALTENATIVE-NAME (A50)
*****
1 #COUNT-MP (N4)
1 #COUNT-KZN (N4)
END-DEFINE

DEFINE WORK FILE 1 
  'C:\Trainings\NEW-DAM-LIST1.csv'
  TYPE 'csv'
DEFINE WORK FILE 2 
  'C:\Trainings\today dams1.txt'


READ WORK FILE 1  
    #DAM-NAME
    #NEAREST-LOCAL
    #PROVINCE
    #IMPOUNDS
    #YEAR
    #RESERVOUR-VOLUME
    #SURFACE-AREA
    #WALL-HEIGHT
    #DAM-ID
    #ALTENATIVE-NAME


  ADD 1 TO DAM-ID

  WRITE WORK FILE 2   
    #DAM-NAME
    #NEAREST-LOCAL
    #PROVINCE
    #IMPOUNDS
    #YEAR
    #RESERVOUR-VOLUME
    #SURFACE-AREA
    #WALL-HEIGHT
    #DAM-ID
    #ALTENATIVE-NAME

*************************
  DAM-NAME := #DAM-NAME
  IMPOUNDS  := #IMPOUNDS
  NEAREST-LOCAL := #NEAREST-LOCAL
  PROVINCE := #PROVINCE
  ALTENATIVE-NAME := #ALTENATIVE-NAME
  IF #DAM-ID IS (N3)
    DAM-ID := VAL(#DAM-ID)
  END-IF

  IF #YEAR IS (N4)
    YEAR  := VAL(#YEAR)
  END-IF

  IF  #RESERVOUR-VOLUME IS (N10.4)
    RESERVOUR-VOLUME := VAL(#RESERVOUR-VOLUME)
  END-IF

  IF #SURFACE-AREA IS (N10.4)
    SURFACE-AREA := VAL(#SURFACE-AREA)
  END-IF

  IF #WALL-HEIGHT IS (N10.4)
    WALL-HEIGHT := VAL(#WALL-HEIGHT)
  END-IF
  EXAMINE PROVINCE FOR 'KZN' REPLACE 'Kwa Zulu Natal'
  DISPLAY  DAM-ID SA-DAMS-DATA.DAM-NAME(AL=20) PROVINCE(AL=15)
    #ALTENATIVE-NAME (AL=20)

  STORE RECORD IN SA-DAMS-DATA
  END OF TRANSACTION
END-WORK

WRITE 'PRINTING WAS A SUCCESS !'

CLOSE WORK FILE 1
CLOSE WORK FILE 2
END
