/* TODO Enter your code here
DEFINE DATA LOCAL
1 SA-DAMS-DATA VIEW OF SA-DAMS
  2 DAM-NAME (A50)
  2 PROVINCE (A50)
1 #COUNT-MP (N4)
1 #COUNT-KZN (N4)
END-DEFINE
READ SA-DAMS-DATA 

DECIDE FOR EVERY CONDITION 
    WHEN PROVINCE = 'KZN' MOVE 'Kwa Zulu Natal' TO PROVINCE
    ADD 1 TO #COUNT-KZN
    WHEN PROVINCE = 'MP' MOVE 'Mpumalanga' TO PROVINCE
    ADD 1 TO #COUNT-MP
    WHEN NONE IGNORE 
END-DECIDE

DISPLAY PROVINCE

* STORE IN SA-DAMS-DATA
* END OF TRANSACTION

END-READ
WRITE 'NUMBER OF MP UPDATED ' #COUNT-MP
WRITE 'NUMBER OF KZN UPDATED ' #COUNT-KZN
END
