* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Program XXBLANKS.
DEFINE DATA LOCAL
1 SA-DAMS-DATA VIEW OF SA-DAMS
  2 DAM-NAME (A50)
  2 IMPOUNDS (A50)
  2 NEAREST-LOCAL (A50)
  2 PROVINCE (A50)
  2 ALTENATIVE-NAME (A50)
  2 DAM-ID (N3.0) /* Dam Identity
  2 YEAR (N4.0)
  2 RESERVOUR-VOLUME (N10.4)
  2 SURFACE-AREA (N10.4)
  2 WALL-HEIGHT (N10.4)
************************************************************
1 #PROGRAM (A8)
1 #COUNT (N5)
1 #START-YEAR (N4) INIT <1884>
1 #CURRENT-YEAR (A18) 
1 REDEFINE #CURRENT-YEAR
  2 #CURR-YEAR (A4)
END-DEFINE

SET KEY
  PF3 NAMED 'EXIT'
  PF5 NAMED 'ADD NEW'
#PROGRAM := *PROGRAM
#CURRENT-YEAR := *DATG
DEFINE WORK FILE 1 "C:\TRAININGS\BLANKS IN DAMS.CSV"
  TYPE 'csv'
READ SA-DAMS-DATA 
    BY DAM-NAME

  IF DAM-NAME = ' '
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF IMPOUNDS  = ' '
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF NEAREST-LOCAL = ' '
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF PROVINCE = ' '
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF ALTENATIVE-NAME = ' '
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF  DAM-ID = 0
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF YEAR < #START-YEAR /*OR YEAR GT VAL(#CURR-YEAR)
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF RESERVOUR-VOLUME < 0
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF SURFACE-AREA < 0
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF

  IF WALL-HEIGHT < 0
    PERFORM WRITE-BLANKS
    ESCAPE TOP
  END-IF
END-READ

DEFINE SUBROUTINE WRITE-BLANKS
ADD 1 TO #COUNT
WRITE WORK 1
  #COUNT 
  DAM-NAME         
  IMPOUNDS  
  NEAREST-LOCAL 
  PROVINCE        
  ALTENATIVE-NAME 
  DAM-ID           
  YEAR 
  RESERVOUR-VOLUME  
  SURFACE-AREA    
  WALL-HEIGHT
END-SUBROUTINE
CLOSE WORK 1
END

