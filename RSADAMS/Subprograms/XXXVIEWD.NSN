/** :author tzu
/* TODO Enter your code here
DEFINE DATA 
PARAMETER

1 #G-MASSAGE (A020)
LOCAL

1 SA-DAMS-DATA VIEW OF SA-DAMS
2 IMPOUNDS (A50)
2 DAM-NAME (A50)
  2 NEAREST-LOCAL (A50)
  2 PROVINCE (A50)
  2 ALTENATIVE-NAME (A50)
  2 DAM-ID (N3.0) /* Dam Identity
  2 YEAR (N4.0)
  2 RESERVOUR-VOLUME (N10.4)
  2 SURFACE-AREA (N10.4)
  2 WALL-HEIGHT (N10.4)
************************************************************
1 #DAM-NAME (A20/1:16)
1 #SELECT (A1/1:16)
/**1 #NEAREST-LOCAL (A20/1:16)
1 #PROVINCE (A20/1:16) 
* 1 #DAM-NAME (A20/1:16)
1 #DAM-NAME1 (A50)
1 #IMPOUNDS (A20/1:16)
1 #ALTENATIVE-NAME (A20/1:16)
1 #DAM-ID (N3.0/1:16) /* Dam Identity
1 #YEAR (N4.0/1:16)
1 #RESERVOUR-VOLUME (N10.4/1:16)
1 #SURFACE-AREA (N10.4/1:16)
1 #WALL-HEIGHT (N10.4/1:16)
1 #NEAREST-LOCAL (A020/00001:00016)
1 #PROGRAM (A8)
1 #RESTART-NAME (A20)
1 #RESTART-NAME2 (A20)
1 #LATE-RESTART-NAME (A20)
1 #REPOS-FLAG (A1)
1 #INDEX (N4)
1 #INDEX1 (N4)
1 #NEW-ID (N03.0)
1 #COUNT (N5)
1 #START-YEAR (N4) INIT <1884>
1 #CURRENT-YEAR (A18) 
1 REDEFINE #CURRENT-YEAR
  2 #CURR-YEAR (A4)
1 #DATE (A18)
1 REDEFINE #DATE
  2 #TIME (A5)
1 #S-MASSAGE (A40) INIT <'DAM Statistics will be available soon!!!'>
1 #SEL (A1/1:3)
1 #I-SEL (N5)
END-DEFINE
SET CONTROL 'MT'
SET KEY
  PF3 NAMED 'EXIT'
*   PF5 NAMED 'ADD NEW'
#PROGRAM := *PROGRAM
#CURRENT-YEAR := *DATG
#DATE := *TIME 

DEFINE WORK FILE 1 "C:\TRAININGS\LOGS.TXT"

READ SA-DAMS-DATA WITH REPOSITION
    BY DAM-NAME
    STARTING FROM #RESTART-NAME2
  ADD 1 TO #INDEX
  ADD 1 TO #COUNT

/**MOVE THE VARIABLE USING PARSING THEIR INDEXES

  MOVE DAM-NAME         TO #DAM-NAME (#INDEX)
  MOVE IMPOUNDS  TO #IMPOUNDS (#INDEX)
  MOVE NEAREST-LOCAL    TO #NEAREST-LOCAL (#INDEX)
  MOVE PROVINCE         TO #PROVINCE (#INDEX)
  MOVE ALTENATIVE-NAME  TO #ALTENATIVE-NAME (#INDEX)
  MOVE DAM-ID           TO #DAM-ID (#INDEX) /* Dam Identity
  MOVE YEAR             TO #YEAR (#INDEX)
  MOVE RESERVOUR-VOLUME TO #RESERVOUR-VOLUME (#INDEX)
  MOVE SURFACE-AREA     TO #SURFACE-AREA (#INDEX)
  MOVE WALL-HEIGHT      TO #WALL-HEIGHT (#INDEX)
  WRITE WORK 1 #COUNT '/'
    *USER '/'
    *TIMN '/'
    *HOSTNAME '/'
    *INIT-ID '/'
    *TIMN '/'
    *INIT-USER '/'
    *EVENT
/**
  IF #INDEX = 16

    REPEAT

      INPUT USING MAP "WK41MP2"

      DECIDE ON EVERY VALUE OF *PF-KEY
        VALUE 'PF3'
          ESCAPE MODULE
*         VALUE 'ENTR'
*           IGNORE
        VALUE 'PF8'
          ESCAPE BOTTOM
        NONE
          IGNORE/**REINPUT 'Enter a valid key !!!'
      END-DECIDE
      DECIDE ON EVERY VALUE OF #TIME
        VALUE  '00:00' : '11:59'
          MOVE 'Good Morning ' TO #G-MASSAGE
        VALUE  '12:00' : '16:59'
          MOVE 'Good Morning ' TO #G-MASSAGE
        VALUE  '17:00' : '23:59'
          MOVE 'Good Evening' TO #G-MASSAGE
        NONE IGNORE
      END-DECIDE

      FOR #INDEX1 = 1 TO 16

        DECIDE ON EVERY VALUE OF #SELECT(#INDEX1)
          VALUE 'A'
            CALLNAT "XDUPDATE" #DAM-ID(#INDEX1) #DAM-NAME1 #G-MASSAGE
          NONE
            IGNORE
        END-DECIDE 
      END-FOR

      IF  #RESTART-NAME NE ' '
        MOVE #RESTART-NAME TO #LATE-RESTART-NAME #RESTART-NAME2
        RESET  #RESTART-NAME
        RESET #INDEX
        MOVE 'Y' TO #REPOS-FLAG
        ESCAPE BOTTOM
      END-IF
      /**
    END-REPEAT
    /**
    RESET #INDEX1
    IF #REPOS-FLAG = 'Y'
      RESET #REPOS-FLAG
      ESCAPE TOP REPOSITION
    END-IF
  END-IF
END-READ


IF #INDEX LE 16

  RESET

    #DAM-ID (#INDEX + 1:16)
    #DAM-NAME(#INDEX + 1:16)
    #WALL-HEIGHT(#INDEX + 1:16)
    #SURFACE-AREA(#INDEX + 1:16)
    #RESERVOUR-VOLUME(#INDEX + 1:16)
    #YEAR(#INDEX + 1:16)
    #ALTENATIVE-NAME(#INDEX + 1:16)
    #PROVINCE(#INDEX + 1:16)
    #NEAREST-LOCAL(#INDEX + 1:16)

    #SELECT (#INDEX + 1:16)

  INPUT MARK *#RESTART-NAME

    USING MAP "WK41MP2"

END-IF
CLOSE WORK 1
END


