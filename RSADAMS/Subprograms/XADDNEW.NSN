* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Subprogram XDUPDATE.

/** :author tzu
/* TODO Enter your code here

DEFINE DATA
PARAMETER
1 #DAM-ID (N3.0)
1 #NEW-ID (N03.0)
1 #G-MASSAGE (A020)

LOCAL
1 SA-DAMS-DATA VIEW OF SA-DAMS
  2 DAM-NAME (A50)
  2 IMPOUNDS (A50)
  2 NEAREST-LOCAL (A50)
  2 PROVINCE (A50)
  2 ALTENATIVE-NAME (A50)
  2 DAM-ID (N3.0) /* Dam Identity
  2 YEAR (N4.0)
  2 RESERVOUR-VOLUME (N10.4)
  2 SURFACE-AREA (N10.4)
  2 WALL-HEIGHT (N10.4)
1 ##DAM-NAME (A50)
1 ##IMPOUNDS (A50)
1 ##NEAREST-LOCAL (A50)
1 ##PROVINCE (A50)
1 ##ALTENATIVE-NAME (A50)
1 ##YEAR (N4.0)
1 ##RESERVOUR-VOLUME (N10.4)
1 ##SURFACE-AREA (N10.4)
1 ##WALL-HEIGHT (N10.4)
1 #DAM-NAME (C)
1 #PROGRAM (A8)
1 #START-YEAR (N4) INIT <1884>
1 #CURRENT-YEAR (A18) 
1 REDEFINE #CURRENT-YEAR
  2 #CURR-YEAR (A4)
  1 #COUNT (N4)
END-DEFINE

SET CONTROL 'MT'
SET KEY
  PF3 NAMED 'EXIT'
#PROGRAM := *PROGRAM
#CURRENT-YEAR := *DATN 

DEFINE WORK FILE 1 "C:\TRAININGS\LOGS-NEW-DAM.TXT"


REPEAT



  READ SA-DAMS-DATA DESCENDING BY DAM-ID
    UPDATE
    ADD 1 TO #COUNT
    IF *PF-KEY = 'PF3'
      ESCAPE MODULE
    END-IF
    
    #DAM-ID := DAM-ID
    ADD 1 TO DAM-ID
    #NEW-ID :=DAM-ID
    INPUT USING MAP "XXADNE"
    MOVE (AD=I) TO
      #DAM-NAME
      IF *PF-KEY = 'PF3'
      ESCAPE MODULE
      END-IF
    INPUT USING MAP "XXADNE"
    /***validation
    IF ##DAM-NAME = ' '
      REINPUT ' Dam Name Can not be left blank!!'
    END-IF

    IF ##YEAR < #START-YEAR OR YEAR GT VAL(#CURR-YEAR)
      REINPUT ' YEAR IS INVALID OR YEAR EXCEED CURRENT YEAR !'
    END-IF
    IF ##NEAREST-LOCAL = ' '
      REINPUT 'Nearest Local Cannot be left blank!!'
    END-IF

    IF ##PROVINCE = ' '
      REINPUT 'Province can not be Left Blank!!'
    END-IF

    IF ##RESERVOUR-VOLUME < 0 OR RESERVOUR-VOLUME  = 0
      REINPUT 'Resevour Volume is < "0" '
    END-IF

    IF ##SURFACE-AREA < 0 OR SURFACE-AREA = 0
      REINPUT 'Surface area is < "0" '
    END-IF

    IF ##WALL-HEIGHT < 0 OR WALL-HEIGHT = 0
      REINPUT 'Wall height is invalid!!'
    END-IF
    MOVE (AD=P) TO
      #DAM-NAME
    DAM-ID :=#DAM-ID
    INPUT WITH TEXT 'DAM WAS ADDED SUCCESSFUL !!' USING MAP "XXADNE"
    DAM-ID :=#DAM-ID
    DAM-NAME :=##DAM-NAME
    IMPOUNDS:=##IMPOUNDS
    NEAREST-LOCAL:=##NEAREST-LOCAL
    PROVINCE:=##PROVINCE
    ALTENATIVE-NAME:=##ALTENATIVE-NAME
    YEAR:=##YEAR
    RESERVOUR-VOLUME:=##RESERVOUR-VOLUME
    SURFACE-AREA:=##SURFACE-AREA
    WALL-HEIGHT:=##WALL-HEIGHT
    
    STORE RECORD IN SA-DAMS-DATA
    END TRANSACTION
    WRITE WORK 1 #COUNT '/'
     *USER '/'
      *TIMN '/'
      *HOSTNAME '/'
      *INIT-ID '/'
      *TIME-OUT
    
  END-READ
END-REPEAT
CLOSE WORK 1
END
